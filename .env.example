# Secrets: never commit real keys. Copy to .env (git-ignored).
PORT=3001

# Marine source:
# demo       = scripted/offline
# open-meteo = live Open-Meteo
# incois     = live INCOIS RSMC WaveWatch III NetCDF
ORCA_DATA_SOURCE=demo\n\n# Maximum age of an INCOIS RSMC WW3 model run before it is rejected as stale.\n# ORCA_INCOIS_RSMC_MAX_AGE_HOURS=72

# Advisories: demo, incois, none. Live marine sources default to no scripted advisories.
# ORCA_ADVISORY_SOURCE=

# Ecosystem: demo, incois, none.
# INCOIS ecosystem currently uses the ERDDAP provider with freshness validation.
# ORCA_ECOSYSTEM_SOURCE=

# Reject ecosystem observations older than this many hours.
# ORCA_ECOSYSTEM_MAX_AGE_HOURS=96

# PFZ: demo, incois, none. INCOIS PFZ remains isolated until an authorized
# machine-readable feed is verified.
# ORCA_PFZ_SOURCE=

# MOSDAC satellite products require an approved SSO account:
# MOSDAC_USERNAME=
# MOSDAC_PASSWORD=
# MOSDAC_DATASET_ID=

# Runtime LLM
# ORCA_LLM=off
# ORCA_MODEL_PROVIDER=gemini
# ORCA_MODEL_NAME=gemini-3.6-flash
# GEMINI_API_KEY=
# ORCA_MODEL_API_KEY=
# ORCA_MODEL_TIMEOUT_MS=15000

VITE_ORCA_API_URL=
