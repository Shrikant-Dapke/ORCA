# ---> Secrets: never commit real keys. Copy to `.env` (git-ignored). <---

# Port for the ORCA API server (`npm run server` / `npm run serve`).
PORT=3001

# Marine data source: "demo" (default, offline-safe sample data) or
# "open-meteo" (live Open-Meteo Marine + Forecast APIs, no key needed,
# requires internet). Unknown values fall back to demo with a warning.
# Health reflects this choice: { dataSource, live }.
ORCA_DATA_SOURCE=demo

# Advisory source: unset pairs automatically (demo marine → demo advisories,
# live marine → none, so live readings are never mixed with scripted warnings).
# Explicit: "demo" (scripted, labeled demo), "incois" (official INCOIS feed —
# not publicly available yet; requests fail honestly with 502, see
# server/safety/incois.ts), "none" (no advisories).
# Health reflects this choice: { advisorySource, advisoryLive }.
# ORCA_ADVISORY_SOURCE=

# Ecosystem source: unset pairs automatically (demo marine → demo ecosystem,
# live marine → live INCOIS ERDDAP SST with freshness gate; failures degrade
# to unavailable, never break safety). Explicit: "demo", "incois", "none".
# Health: { ecosystemSource, ecosystemLive, ecosystemDataset }.
# ORCA_ECOSYSTEM_SOURCE=

# Freshness gate for live ecosystem observations (hours). Default 96 (≈ daily
# product cadence + processing lag). Observations older than this are rejected
# and reported unavailable — stale data is never labeled live.
# ORCA_ECOSYSTEM_MAX_AGE_HOURS=96

# Fishing-zone source: unset pairs automatically (demo marine → demo zones,
# live marine → none, so live readings are never mixed with scripted zones).
# Explicit: "demo" (scripted, labeled demo), "incois" (official PFZ feed —
# no machine-readable API exists; requests fail honestly, see
# server/ecosystem/pfz.ts), "none" (no zones).
# ORCA_PFZ_SOURCE=

# MOSDAC satellite products need a registered SSO account (not configured):
# MOSDAC_USERNAME, MOSDAC_PASSWORD, MOSDAC_DATASET_ID (see server/satellite/mosdac.ts).

# Optional: point the web UI at a remote ORCA server.
# Leave empty for same-origin (/api via Vite proxy in dev,
# same port via `npm run serve` in production).
VITE_ORCA_API_URL=
